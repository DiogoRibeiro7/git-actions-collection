{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@actions/core": ["./tests/__mocks__/@actions/core.ts"],
      "@actions/github": ["./tests/__mocks__/@actions/github.ts"]
    },
    "outDir": "dist"
  },
  "include": ["tests/**/*.ts", "vitest.config.mts"]
}
